      "id": "tip-sticky-error",
      "name": "Sticky Note - Error",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [-100, 840]
    },
    {
      "parameters": {
        "functionCode": "// Decode base64 file content and add as binary data\nconst base64Content = $input.item.json.file_content_base64;\nconst binaryBuffer = Buffer.from(base64Content, 'base64');\n\nreturn {\n  json: $input.item.json,\n  binary: {\n    file_data: {\n      data: binaryBuffer.toString('base64'),\n      mimeType: $input.item.json.mime_type,\n      fileName: $input.item.json.filename\n    }\n  }\n};"
      },
      "id": "tip-decode-base64",
      "name": "Decode Base64 File",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-680, 1280],
      "notes": "Converts base64 string to binary data for extraction nodes"
    }
