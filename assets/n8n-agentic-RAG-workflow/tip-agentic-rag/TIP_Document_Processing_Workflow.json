    {
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE knowledge_documents SET chunking_strategy = jsonb_build_object('schema', '{{ $json.schema }}'::jsonb, 'type', 'tabular'), upload_status = 'COMPLETED', chunk_count = (SELECT COUNT(*) FROM document_rows WHERE dataset_id = '{{ $('Extract Document Info').first().json.document_id }}') WHERE id = '{{ $('Extract Document Info').first().json.document_id }}';",
        "options": {}
      },
      "id": "tip-update-completed-tabular",
      "name": "Update Status - Completed (Tabular)",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [280, 1100],
      "credentials": {
        "postgres": {
          "id": "{{ POSTGRES_CREDENTIAL_ID }}",
          "name": "TIP PostgreSQL"
        }
      }
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE knowledge_documents SET upload_status = 'COMPLETED', chunk_count = (SELECT COUNT(*) FROM knowledge_document_chunks WHERE document_id = '{{ $('Extract Document Info').first().json.document_id }}') WHERE id = '{{ $('Extract Document Info').first().json.document_id }}';",
        "options": {}
      },
      "id": "tip-update-completed-text",
      "name": "Update Status - Completed (Text)",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [440, 1360],
      "credentials": {
        "postgres": {
          "id": "{{ POSTGRES_CREDENTIAL_ID }}",
          "name": "TIP PostgreSQL"
        }
      }
    },
    {
      "parameters": {
        "errorWorkflow": "error-handler",
        "operation": "executeQuery",
        "query": "UPDATE knowledge_documents SET upload_status = 'FAILED', processing_error = '{{ $json.error.message }}' WHERE id = '{{ $('Extract Document Info').first().json.document_id }}';",
        "options": {}
      },
      "id": "tip-error-handler",
      "name": "Error Handler",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [80, 900],
      "onError": "continueRegularOutput",
      "credentials": {
        "postgres": {
          "id": "{{ POSTGRES_CREDENTIAL_ID }}",
          "name": "TIP PostgreSQL"
        }
      }
    },
    {
      "parameters": {
        "content": "## Error Handling\n\nIf any node fails, document status is updated to FAILED with error message",
        "height": 200,
        "width": 400,
        "color": 7
