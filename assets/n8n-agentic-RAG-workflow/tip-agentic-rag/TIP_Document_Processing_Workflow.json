      "notes": "Receives webhook from backend-python when document is uploaded"
    },
    {
      "parameters": {
        "content": "## TIP Document Processing Workflow\n\nProcesses uploaded documents:\n1. Receive webhook from Python API\n2. Route by file type (PDF, DOCX, CSV, Excel)\n3. Extract text/data\n4. Chunk content\n5. Generate embeddings (Ollama)\n6. Store in PostgreSQL\n7. Update document status",
        "height": 867,
        "width": 3073,
        "color": 5
      },
      "id": "tip-sticky-processing",
      "name": "Sticky Note - Processing",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [-1280, 1000]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "document-id",
              "name": "document_id",
              "value": "={{ $json.body.document_id }}",
              "type": "string"
            },
            {
              "id": "filename",
              "name": "filename",
              "value": "={{ $json.body.filename }}",
              "type": "string"
            },
            {
              "id": "mime-type",
