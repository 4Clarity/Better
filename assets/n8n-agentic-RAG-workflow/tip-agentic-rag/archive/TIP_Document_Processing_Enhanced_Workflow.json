      "id": "update-status-analyzing",
      "name": "Update Status - Analyzing",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.4,
      "position": [400, 300],
      "credentials": {
        "postgres": {
          "id": "{{ POSTGRES_CREDENTIAL_ID }}",
          "name": "TIP PostgreSQL"
