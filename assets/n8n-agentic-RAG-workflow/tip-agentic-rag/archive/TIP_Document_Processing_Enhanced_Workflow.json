    {
      "parameters": {
        "jsCode": "// Calculate quality score based on document characteristics\nconst items = $input.all();\nconst firstItem = items[0].json;\n\nconst chunkCount = items.length;\nconst avgTokenCount = items.reduce((sum, item) => sum + (item.json.token_count || 0), 0) / chunkCount;\nconst hasMetadata = !!firstItem.metadata;\nconst filenameQuality = firstItem.filename && firstItem.filename.length > 5 ? 0.2 : 0;\n\n// Quality score components:\n// - Chunk count (optimal 5-50 chunks): 0-0.3\n// - Average token count (optimal 300-600): 0-0.3\n// - Has metadata: 0.2\n// - Filename quality: 0.2\n\nlet chunkScore = 0.3;\nif (chunkCount < 3) chunkScore = 0.1;\nelse if (chunkCount > 100) chunkScore = 0.15;\n\nlet tokenScore = 0.3;\nif (avgTokenCount < 100) tokenScore = 0.1;\nelse if (avgTokenCount > 1000) tokenScore = 0.15;\n\nconst qualityScore = chunkScore + tokenScore + (hasMetadata ? 0.2 : 0) + filenameQuality;\n\nreturn {\n  json: {\n    document_id: firstItem.document_id,\n    quality_score: Math.min(qualityScore, 1.0).toFixed(2),\n    chunk_count: chunkCount,\n    avg_token_count: Math.round(avgTokenCount),\n    auto_approve: qualityScore >= 0.7\n  }\n};"
      },
      "id": "calculate-quality-score",
      "name": "Calculate Quality Score",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1800, 200]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO curation_queue (id, item_type, item_id, status, priority, quality_score, metadata, created_at, updated_at) VALUES (gen_random_uuid()::TEXT, 'document', '{{ $json.document_id }}', '{{ $json.auto_approve ? \"approved\" : \"pending\" }}', 'normal', {{ $json.quality_score }}, '{\"chunk_count\":{{ $json.chunk_count }},\"avg_tokens\":{{ $json.avg_token_count }}}', NOW(), NOW())",
        "options": {}
      },
