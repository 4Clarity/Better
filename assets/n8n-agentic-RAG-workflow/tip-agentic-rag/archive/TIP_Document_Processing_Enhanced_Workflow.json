    {
      "parameters": {
        "jsCode": "// Decode base64 file content\nconst base64Content = $input.item.json.file_content;\nconst fileBuffer = Buffer.from(base64Content, 'base64');\n\nreturn {\n  json: {\n    ...item.json,\n    file_buffer: fileBuffer,\n    file_size_bytes: fileBuffer.length\n  },\n  binary: {\n    data: {\n      data: base64Content,\n      mimeType: $input.item.json.mime_type,\n      fileName: $input.item.json.filename\n    }\n  }\n};"
      },
      "id": "decode-file-enhanced",
      "name": "Decode Base64 File",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [600, 300]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO document_versions (id, document_id, version_number, content_hash, docling_metadata, created_at) VALUES (gen_random_uuid()::TEXT, '{{ $json.document_id }}', 1, encode(digest('{{ $json.file_content }}', 'sha256'), 'hex'), '{\"processed_by\":\"docling\",\"workflow\":\"n8n\"}', NOW())",
        "options": {}
      },
      "id": "create-version-record",
      "name": "Create Version Record",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.4,
      "position": [800, 300],
      "credentials": {
        "postgres": {
          "id": "{{ POSTGRES_CREDENTIAL_ID }}",
          "name": "TIP PostgreSQL"
        }
      }
    },
