      "id": "insert-chunks-enhanced",
      "name": "Insert Chunks to PostgreSQL",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.4,
      "position": [1600, 200],
      "credentials": {
        "postgres": {
          "id": "{{ POSTGRES_CREDENTIAL_ID }}",
          "name": "TIP PostgreSQL"
