// ===========================================================================
// Roadmap UI Models - Story 1.5
// ===========================================================================

model platform_setup {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  step_number      Int       @db.SmallInt
  step_name        String    @db.VarChar(100)
  step_description String?
  status           String    @default("not-started") @db.VarChar(50)
  completed_at     DateTime? @db.Timestamp(6)
  completed_by     String?   @db.VarChar(255)
  metadata         Json      @default("{}")
  created_at       DateTime  @default(now()) @db.Timestamp(6)
  updated_at       DateTime  @default(now()) @db.Timestamp(6)
  user             User?     @relation("platform_setup_completed_byTousers", fields: [completed_by], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@unique([step_number])
  @@index([status], map: "idx_platform_setup_status")
  @@index([step_number], map: "idx_platform_setup_step_number")
}

model handover_checklist_items {
  id            String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  transition_id String      @db.VarChar(255)
  user_id       String      @db.VarChar(255)
  item_text     String
  item_category String?     @db.VarChar(100)
  order_index   Int         @default(0) @db.SmallInt
  completed     Boolean     @default(false)
  completed_at  DateTime?   @db.Timestamp(6)
  notes         String?
  created_at    DateTime    @default(now()) @db.Timestamp(6)
  updated_at    DateTime    @default(now()) @db.Timestamp(6)
  transition    transitions @relation(fields: [transition_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
  user          User        @relation("handover_checklist_items_userTousers", fields: [user_id], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([transition_id], map: "idx_handover_checklist_transition")
  @@index([user_id], map: "idx_handover_checklist_user")
  @@index([completed], map: "idx_handover_checklist_completed")
  @@index([transition_id, order_index], map: "idx_handover_checklist_order")
}

model learning_modules {
  id                  String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  module_name         String                   @db.VarChar(200)
  description         String?
  module_category     String?                  @db.VarChar(100)
  order_index         Int                      @default(0) @db.SmallInt
  estimated_hours     Decimal?                 @db.Decimal(5, 2)
  content_url         String?                  @db.VarChar(500)
  prerequisites       Json                     @default("[]")
  learning_objectives String?
  is_active           Boolean                  @default(true)
  created_at          DateTime                 @default(now()) @db.Timestamp(6)
  updated_at          DateTime                 @default(now()) @db.Timestamp(6)
  user_progress       user_learning_progress[]

  @@unique([module_name])
  @@index([is_active], map: "idx_learning_modules_active")
  @@index([order_index], map: "idx_learning_modules_order")
  @@index([module_category], map: "idx_learning_modules_category")
}

model user_learning_progress {
  id                  String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id             String           @db.VarChar(255)
  module_id           String           @db.Uuid
  transition_id       String?          @db.VarChar(255)
  progress_percentage Int              @default(0) @db.SmallInt
  status              String           @default("not-started") @db.VarChar(50)
  started_at          DateTime?        @db.Timestamp(6)
  completed_at        DateTime?        @db.Timestamp(6)
  quiz_score          Decimal?         @db.Decimal(5, 2)
  time_spent_minutes  Int              @default(0)
  notes               String?
  created_at          DateTime         @default(now()) @db.Timestamp(6)
  updated_at          DateTime         @default(now()) @db.Timestamp(6)
  user                User             @relation("user_learning_progress_userTousers", fields: [user_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
  module              learning_modules @relation(fields: [module_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
  transition          transitions?     @relation(fields: [transition_id], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@unique([user_id, module_id])
  @@index([user_id], map: "idx_user_learning_progress_user")
  @@index([module_id], map: "idx_user_learning_progress_module")
  @@index([transition_id], map: "idx_user_learning_progress_transition")
  @@index([status], map: "idx_user_learning_progress_status")
  @@index([user_id, completed_at], map: "idx_user_learning_progress_completion")
}

model skills_master {
  id                   String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  skill_name           String                 @db.VarChar(200)
  description          String?
  skill_category       String?                @db.VarChar(100)
  proficiency_levels   Json                   @default("[\"beginner\", \"intermediate\", \"advanced\", \"expert\"]")
  assessment_criteria  String?
  related_modules      Json                   @default("[]")
  is_active            Boolean                @default(true)
  created_at           DateTime               @default(now()) @db.Timestamp(6)
  updated_at           DateTime               @default(now()) @db.Timestamp(6)
  user_skills_progress user_skills_progress[]

  @@unique([skill_name])
  @@index([is_active], map: "idx_skills_master_active")
  @@index([skill_category], map: "idx_skills_master_category")
}

model user_skills_progress {
  id                  String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id             String        @db.VarChar(255)
  skill_id            String        @db.Uuid
  transition_id       String?       @db.VarChar(255)
  progress_percentage Int           @default(0) @db.SmallInt
  current_level       String        @default("beginner") @db.VarChar(50)
  target_level        String        @default("expert") @db.VarChar(50)
  assessed_at         DateTime?     @db.Timestamp(6)
  assessed_by         String?       @db.VarChar(255)
  assessment_notes    String?
  created_at          DateTime      @default(now()) @db.Timestamp(6)
  updated_at          DateTime      @default(now()) @db.Timestamp(6)
  user                User          @relation("user_skills_progress_userTousers", fields: [user_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
  skill               skills_master @relation(fields: [skill_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
  transition          transitions?  @relation(fields: [transition_id], references: [id], onDelete: SetNull, onUpdate: Cascade)
  assessor            User?         @relation("user_skills_progress_assessorTousers", fields: [assessed_by], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@unique([user_id, skill_id])
  @@index([user_id], map: "idx_user_skills_progress_user")
  @@index([skill_id], map: "idx_user_skills_progress_skill")
  @@index([transition_id], map: "idx_user_skills_progress_transition")
  @@index([current_level], map: "idx_user_skills_progress_level")
}

model chat_sessions {
  id              String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id         String       @db.VarChar(255)
  transition_id   String?      @db.VarChar(255)
  session_title   String?      @db.VarChar(255)
  messages        Json         @default("[]")
  message_count   Int          @default(0)
  context_data    Json         @default("{}")
  is_active       Boolean      @default(true)
  last_message_at DateTime?    @db.Timestamp(6)
  created_at      DateTime     @default(now()) @db.Timestamp(6)
  updated_at      DateTime     @default(now()) @db.Timestamp(6)
  user            User         @relation("chat_sessions_userTousers", fields: [user_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
  transition      transitions? @relation(fields: [transition_id], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([user_id], map: "idx_chat_sessions_user")
  @@index([transition_id], map: "idx_chat_sessions_transition")
  @@index([is_active], map: "idx_chat_sessions_active")
  @@index([last_message_at], map: "idx_chat_sessions_last_message")
  @@index([user_id, is_active], map: "idx_chat_sessions_user_active")
}

model activity_logs {
  id                String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id           String       @db.VarChar(255)
  transition_id     String?      @db.VarChar(255)
  activity_type     String       @db.VarChar(100)
  activity_category String?      @db.VarChar(100)
  description       String
  entity_type       String?      @db.VarChar(100)
  entity_id         String?      @db.VarChar(255)
  metadata          Json         @default("{}")
  ip_address        String?      @db.VarChar(45)
  user_agent        String?
  timestamp         DateTime     @default(now()) @db.Timestamp(6)
  user              User         @relation("activity_logs_userTousers", fields: [user_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
  transition        transitions? @relation(fields: [transition_id], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([user_id], map: "idx_activity_logs_user")
  @@index([transition_id], map: "idx_activity_logs_transition")
  @@index([activity_type], map: "idx_activity_logs_type")
  @@index([activity_category], map: "idx_activity_logs_category")
  @@index([timestamp], map: "idx_activity_logs_timestamp")
  @@index([entity_type, entity_id], map: "idx_activity_logs_entity")
  @@index([user_id, timestamp], map: "idx_activity_logs_user_timestamp")
}
