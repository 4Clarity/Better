import { describe, it, expect, beforeEach, afterEach, vi } from 'vitest';\nimport { render, screen, fireEvent, waitFor } from '@testing-library/react';\nimport userEvent from '@testing-library/user-event';\nimport { KnowledgeSourceConfigModal } from '../KnowledgeSourceConfigModal';\nimport { knowledgeSourceApi } from '../../../services/knowledgeSourceApi';\n\n// Mock the API service\nvi.mock('../../../services/knowledgeSourceApi');\n\nconst mockKnowledgeSourceApi = knowledgeSourceApi as any;\n\ndescribe('KnowledgeSourceConfigModal', () => {\n  const mockOnClose = vi.fn();\n  const mockOnSuccess = vi.fn();\n  \n  const defaultProps = {\n    isOpen: true,\n    onClose: mockOnClose,\n    onSuccess: mockOnSuccess,\n    editingSource: null\n  };\n  \n  beforeEach(() => {\n    vi.clearAllMocks();\n    mockKnowledgeSourceApi.createKnowledgeSource.mockResolvedValue({\n      id: 'test-id',\n      name: 'Test Source',\n      endpointUrl: 'https://api.test.com'\n    });\n    mockKnowledgeSourceApi.testConnectionConfig.mockResolvedValue({\n      status: 'healthy',\n      message: 'Connection successful'\n    });\n  });\n  \n  afterEach(() => {\n    vi.restoreAllMocks();\n  });\n\n  it('should render modal when open', () => {\n    render(<KnowledgeSourceConfigModal {...defaultProps} />);\n    \n    expect(screen.getByText('Add Knowledge Source')).toBeInTheDocument();\n    expect(screen.getByLabelText('Name *')).toBeInTheDocument();\n    expect(screen.getByLabelText('Endpoint URL *')).toBeInTheDocument();\n    expect(screen.getByLabelText('Authentication Type')).toBeInTheDocument();\n  });\n  \n  it('should not render modal when closed', () => {\n    render(<KnowledgeSourceConfigModal {...defaultProps} isOpen={false} />);\n    \n    expect(screen.queryByText('Add Knowledge Source')).not.toBeInTheDocument();\n  });\n  \n  it('should show edit mode when editing source', () => {\n    const editingSource = {\n      id: 'source-1',\n      name: 'Existing Source',\n      description: 'Existing description',\n      endpointUrl: 'https://api.existing.com',\n      authType: 'basic' as const,\n      authConfig: { username: 'test' },\n      status: 'active' as const,\n      metadata: {},\n      createdAt: '2024-01-01T00:00:00Z',\n      updatedAt: '2024-01-01T00:00:00Z',\n      createdBy: 'user-1'\n    };\n    \n    render(\n      <KnowledgeSourceConfigModal \n        {...defaultProps} \n        editingSource={editingSource}\n      />\n    );\n    \n    expect(screen.getByText('Edit Knowledge Source')).toBeInTheDocument();\n    expect(screen.getByDisplayValue('Existing Source')).toBeInTheDocument();\n    expect(screen.getByDisplayValue('https://api.existing.com')).toBeInTheDocument();\n  });\n  \n  it('should validate required fields', async () => {\n    const user = userEvent.setup();\n    render(<KnowledgeSourceConfigModal {...defaultProps} />);\n    \n    const createButton = screen.getByText('Create Source');\n    await user.click(createButton);\n    \n    await waitFor(() => {\n      expect(screen.getByText('Name is required')).toBeInTheDocument();\n    });\n  });\n  \n  it('should validate URL format', async () => {\n    const user = userEvent.setup();\n    render(<KnowledgeSourceConfigModal {...defaultProps} />);\n    \n    const nameInput = screen.getByLabelText('Name *');\n    const urlInput = screen.getByLabelText('Endpoint URL *');\n    const createButton = screen.getByText('Create Source');\n    \n    await user.type(nameInput, 'Test Source');\n    await user.type(urlInput, 'invalid-url');\n    await user.click(createButton);\n    \n    await waitFor(() => {\n      expect(screen.getByText('Please enter a valid URL')).toBeInTheDocument();\n    });\n  });\n  \n  it('should validate basic auth credentials', async () => {\n    const user = userEvent.setup();\n    render(<KnowledgeSourceConfigModal {...defaultProps} />);\n    \n    const nameInput = screen.getByLabelText('Name *');\n    const urlInput = screen.getByLabelText('Endpoint URL *');\n    const authSelect = screen.getByDisplayValue('No Authentication');\n    const createButton = screen.getByText('Create Source');\n    \n    await user.type(nameInput, 'Test Source');\n    await user.type(urlInput, 'https://api.test.com');\n    await user.click(authSelect);\n    await user.click(screen.getByText('Basic Authentication'));\n    await user.click(createButton);\n    \n    await waitFor(() => {\n      expect(screen.getByText('Username and password are required for basic authentication')).toBeInTheDocument();\n    });\n  });\n  \n  it('should show auth fields based on auth type', async () => {\n    const user = userEvent.setup();\n    render(<KnowledgeSourceConfigModal {...defaultProps} />);\n    \n    const authSelect = screen.getByDisplayValue('No Authentication');\n    \n    // Test basic auth fields\n    await user.click(authSelect);\n    await user.click(screen.getByText('Basic Authentication'));\n    \n    expect(screen.getByLabelText('Username')).toBeInTheDocument();\n    expect(screen.getByLabelText('Password')).toBeInTheDocument();\n    \n    // Test API key fields\n    await user.click(authSelect);\n    await user.click(screen.getByText('API Key'));\n    \n    expect(screen.getByLabelText('API Key')).toBeInTheDocument();\n    expect(screen.getByLabelText('Header Name (optional)')).toBeInTheDocument();\n    \n    // Test OAuth fields\n    await user.click(authSelect);\n    await user.click(screen.getByText('OAuth 2.0'));\n    \n    expect(screen.getByLabelText('Client ID')).toBeInTheDocument();\n    expect(screen.getByLabelText('Client Secret')).toBeInTheDocument();\n    expect(screen.getByLabelText('Token URL (optional)')).toBeInTheDocument();\n  });\n  \n  it('should test connection configuration', async () => {\n    const user = userEvent.setup();\n    render(<KnowledgeSourceConfigModal {...defaultProps} />);\n    \n    const nameInput = screen.getByLabelText('Name *');\n    const urlInput = screen.getByLabelText('Endpoint URL *');\n    const testButton = screen.getByText('Test Connection');\n    \n    await user.type(nameInput, 'Test Source');\n    await user.type(urlInput, 'https://api.test.com');\n    await user.click(testButton);\n    \n    await waitFor(() => {\n      expect(mockKnowledgeSourceApi.testConnectionConfig).toHaveBeenCalledWith({\n        name: 'Test Source',\n        endpointUrl: 'https://api.test.com',\n        sourceType: 'REST_API',\n        authType: 'none',\n        authConfig: {},\n        metadata: {}\n      });\n    });\n    \n    await waitFor(() => {\n      expect(screen.getByText('Connection successful')).toBeInTheDocument();\n    });\n  });\n  \n  it('should handle test connection failure', async () => {\n    const user = userEvent.setup();\n    mockKnowledgeSourceApi.testConnectionConfig.mockRejectedValue(\n      new Error('Connection failed')\n    );\n    \n    render(<KnowledgeSourceConfigModal {...defaultProps} />);\n    \n    const nameInput = screen.getByLabelText('Name *');\n    const urlInput = screen.getByLabelText('Endpoint URL *');\n    const testButton = screen.getByText('Test Connection');\n    \n    await user.type(nameInput, 'Test Source');\n    await user.type(urlInput, 'https://api.test.com');\n    await user.click(testButton);\n    \n    await waitFor(() => {\n      expect(screen.getByText('Connection failed')).toBeInTheDocument();\n    });\n  });\n  \n  it('should create knowledge source successfully', async () => {\n    const user = userEvent.setup();\n    render(<KnowledgeSourceConfigModal {...defaultProps} />);\n    \n    const nameInput = screen.getByLabelText('Name *');\n    const urlInput = screen.getByLabelText('Endpoint URL *');\n    const createButton = screen.getByText('Create Source');\n    \n    await user.type(nameInput, 'Test Source');\n    await user.type(urlInput, 'https://api.test.com');\n    await user.click(createButton);\n    \n    await waitFor(() => {\n      expect(mockKnowledgeSourceApi.createKnowledgeSource).toHaveBeenCalledWith({\n        name: 'Test Source',\n        endpointUrl: 'https://api.test.com',\n        sourceType: 'REST_API',\n        authType: 'none',\n        authConfig: {},\n        metadata: {}\n      });\n    });\n    \n    await waitFor(() => {\n      expect(mockOnSuccess).toHaveBeenCalledWith({\n        id: 'test-id',\n        name: 'Test Source',\n        endpointUrl: 'https://api.test.com'\n      });\n      expect(mockOnClose).toHaveBeenCalled();\n    });\n  });\n  \n  it('should handle create knowledge source error', async () => {\n    const user = userEvent.setup();\n    mockKnowledgeSourceApi.createKnowledgeSource.mockRejectedValue(\n      new Error('Creation failed')\n    );\n    \n    render(<KnowledgeSourceConfigModal {...defaultProps} />);\n    \n    const nameInput = screen.getByLabelText('Name *');\n    const urlInput = screen.getByLabelText('Endpoint URL *');\n    const createButton = screen.getByText('Create Source');\n    \n    await user.type(nameInput, 'Test Source');\n    await user.type(urlInput, 'https://api.test.com');\n    await user.click(createButton);\n    \n    await waitFor(() => {\n      expect(screen.getByText('Creation failed')).toBeInTheDocument();\n    });\n  });\n  \n  it('should update knowledge source when editing', async () => {\n    const user = userEvent.setup();\n    const editingSource = {\n      id: 'source-1',\n      name: 'Existing Source',\n      description: 'Existing description',\n      endpointUrl: 'https://api.existing.com',\n      authType: 'none' as const,\n      authConfig: {},\n      status: 'active' as const,\n      metadata: {},\n      createdAt: '2024-01-01T00:00:00Z',\n      updatedAt: '2024-01-01T00:00:00Z',\n      createdBy: 'user-1'\n    };\n    \n    mockKnowledgeSourceApi.updateKnowledgeSource.mockResolvedValue({\n      ...editingSource,\n      name: 'Updated Source'\n    });\n    \n    render(\n      <KnowledgeSourceConfigModal \n        {...defaultProps} \n        editingSource={editingSource}\n      />\n    );\n    \n    const nameInput = screen.getByDisplayValue('Existing Source');\n    const updateButton = screen.getByText('Update Source');\n    \n    await user.clear(nameInput);\n    await user.type(nameInput, 'Updated Source');\n    await user.click(updateButton);\n    \n    await waitFor(() => {\n      expect(mockKnowledgeSourceApi.updateKnowledgeSource).toHaveBeenCalledWith(\n        'source-1',\n        expect.objectContaining({\n          name: 'Updated Source'\n        })\n      );\n    });\n  });\n  \n  it('should close modal on cancel', async () => {\n    const user = userEvent.setup();\n    render(<KnowledgeSourceConfigModal {...defaultProps} />);\n    \n    const cancelButton = screen.getByText('Cancel');\n    await user.click(cancelButton);\n    \n    expect(mockOnClose).toHaveBeenCalled();\n  });\n  \n  it('should reset form when modal opens/closes', () => {\n    const { rerender } = render(\n      <KnowledgeSourceConfigModal {...defaultProps} isOpen={false} />\n    );\n    \n    rerender(<KnowledgeSourceConfigModal {...defaultProps} isOpen={true} />);\n    \n    const nameInput = screen.getByLabelText('Name *');\n    expect(nameInput).toHaveValue('');\n  });\n  \n  it('should show loading state during submission', async () => {\n    const user = userEvent.setup();\n    \n    // Mock a delayed response\n    mockKnowledgeSourceApi.createKnowledgeSource.mockImplementation(\n      () => new Promise(resolve => setTimeout(resolve, 100))\n    );\n    \n    render(<KnowledgeSourceConfigModal {...defaultProps} />);\n    \n    const nameInput = screen.getByLabelText('Name *');\n    const urlInput = screen.getByLabelText('Endpoint URL *');\n    const createButton = screen.getByText('Create Source');\n    \n    await user.type(nameInput, 'Test Source');\n    await user.type(urlInput, 'https://api.test.com');\n    await user.click(createButton);\n    \n    // Check for loading spinner\n    expect(screen.getByRole('button', { name: /create source/i })).toBeDisabled();\n  });\n});