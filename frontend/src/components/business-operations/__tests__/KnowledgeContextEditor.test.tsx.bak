import { describe, it, expect, beforeEach, afterEach, vi } from 'vitest';
import { render, screen, waitFor } from '@testing-library/react';
import userEvent from '@testing-library/user-event';
import KnowledgeContextEditor from '../KnowledgeContextEditor';

describe('KnowledgeContextEditor', () => {
  const defaultProps = {
    productProgramId: 'test-product-id',
    initialContext: 'Initial knowledge context',
    canEdit: true,
    onSave: vi.fn(),
  };

  beforeEach(() => {
    vi.clearAllMocks();
    defaultProps.onSave.mockResolvedValue(undefined);
  });

  afterEach(() => {
    vi.restoreAllMocks();
  });

  describe('Rendering', () => {
    it('should render knowledge context in view mode', () => {
      render(<KnowledgeContextEditor {...defaultProps} />);

      expect(screen.getByText('Knowledge Context')).toBeInTheDocument();
      expect(
        screen.getByText('Additional narrative context for knowledge management')
      ).toBeInTheDocument();
      expect(
        screen.getByText('Initial knowledge context')
      ).toBeInTheDocument();
    });

    it('should show empty state when no context provided', () => {
      render(
        <KnowledgeContextEditor {...defaultProps} initialContext={null} />
      );

      expect(
        screen.getByText('No knowledge context provided yet.')
      ).toBeInTheDocument();
      expect(
        screen.getByText('Click "Edit" to add contextual information.')
      ).toBeInTheDocument();
    });

    it('should show empty state for empty string context', () => {
      render(<KnowledgeContextEditor {...defaultProps} initialContext="" />);

      expect(
        screen.getByText('No knowledge context provided yet.')
      ).toBeInTheDocument();
    });

    it('should show empty state for whitespace-only context', () => {
      render(
        <KnowledgeContextEditor {...defaultProps} initialContext="   " />
      );

      expect(
        screen.getByText('No knowledge context provided yet.')
      ).toBeInTheDocument();
    });

    it('should show Edit button when canEdit is true', () => {
      render(<KnowledgeContextEditor {...defaultProps} />);

      expect(screen.getByText('Edit')).toBeInTheDocument();
    });

    it('should not show Edit button when canEdit is false', () => {
      render(<KnowledgeContextEditor {...defaultProps} canEdit={false} />);

      expect(screen.queryByText('Edit')).not.toBeInTheDocument();
    });

    it('should not show helper text in empty state when canEdit is false', () => {
      render(
        <KnowledgeContextEditor
          {...defaultProps}
          initialContext={null}
          canEdit={false}
        />
      );

      expect(
        screen.getByText('No knowledge context provided yet.')
      ).toBeInTheDocument();
      expect(
        screen.queryByText('Click "Edit" to add contextual information.')
      ).not.toBeInTheDocument();
    });

    it('should update context when initialContext changes', () => {
      const { rerender } = render(
        <KnowledgeContextEditor {...defaultProps} initialContext="First" />
      );

      expect(screen.getByText('First')).toBeInTheDocument();

      rerender(
        <KnowledgeContextEditor {...defaultProps} initialContext="Second" />
      );

      expect(screen.queryByText('First')).not.toBeInTheDocument();
      expect(screen.getByText('Second')).toBeInTheDocument();
    });
  });

  describe('Edit Mode', () => {
    it('should enter edit mode when Edit button is clicked', async () => {
      const user = userEvent.setup();
      render(<KnowledgeContextEditor {...defaultProps} />);

      const editButton = screen.getByText('Edit');
      await user.click(editButton);

      expect(
        screen.getByPlaceholderText('Enter knowledge context information...')
      ).toBeInTheDocument();
      expect(screen.getByText('Save Changes')).toBeInTheDocument();
      expect(screen.getByText('Cancel')).toBeInTheDocument();
    });

    it('should display current context in textarea when entering edit mode', async () => {
      const user = userEvent.setup();
      render(<KnowledgeContextEditor {...defaultProps} />);

      const editButton = screen.getByText('Edit');
      await user.click(editButton);

      const textarea = screen.getByPlaceholderText(
        'Enter knowledge context information...'
      );
      expect(textarea).toHaveValue('Initial knowledge context');
    });

    it('should show character count', async () => {
      const user = userEvent.setup();
      render(<KnowledgeContextEditor {...defaultProps} />);

      const editButton = screen.getByText('Edit');
      await user.click(editButton);

      expect(screen.getByText('25 characters')).toBeInTheDocument();
    });

    it('should update character count when typing', async () => {
      const user = userEvent.setup();
      render(<KnowledgeContextEditor {...defaultProps} />);

      const editButton = screen.getByText('Edit');
      await user.click(editButton);

      const textarea = screen.getByPlaceholderText(
        'Enter knowledge context information...'
      );
      await user.clear(textarea);
      await user.type(textarea, 'New text');

      expect(screen.getByText('8 characters')).toBeInTheDocument();
    });

    it('should hide Edit button when in edit mode', async () => {
      const user = userEvent.setup();
      render(<KnowledgeContextEditor {...defaultProps} />);

      const editButton = screen.getByText('Edit');
      await user.click(editButton);

      expect(screen.queryByText('Edit')).not.toBeInTheDocument();
    });
  });

  describe('Saving Changes', () => {
    it('should save changes successfully', async () => {
      const user = userEvent.setup();
      render(<KnowledgeContextEditor {...defaultProps} />);

      const editButton = screen.getByText('Edit');
      await user.click(editButton);

      const textarea = screen.getByPlaceholderText(
        'Enter knowledge context information...'
      );
      await user.clear(textarea);
      await user.type(textarea, 'Updated context');

      const saveButton = screen.getByText('Save Changes');
      await user.click(saveButton);

      await waitFor(() => {
        expect(defaultProps.onSave).toHaveBeenCalledWith('Updated context');
      });
    });

    it('should exit edit mode after successful save', async () => {
      const user = userEvent.setup();
      render(<KnowledgeContextEditor {...defaultProps} />);

      const editButton = screen.getByText('Edit');
      await user.click(editButton);

      const textarea = screen.getByPlaceholderText(
        'Enter knowledge context information...'
      );
      await user.clear(textarea);
      await user.type(textarea, 'Updated context');

      const saveButton = screen.getByText('Save Changes');
      await user.click(saveButton);

      await waitFor(() => {
        expect(
          screen.queryByPlaceholderText('Enter knowledge context information...')
        ).not.toBeInTheDocument();
      });
    });

    it('should disable Save Changes button when no changes made', async () => {
      const user = userEvent.setup();
      render(<KnowledgeContextEditor {...defaultProps} />);

      const editButton = screen.getByText('Edit');
      await user.click(editButton);

      const saveButton = screen.getByText('Save Changes');
      expect(saveButton).toBeDisabled();
    });

    it('should enable Save Changes button when changes are made', async () => {
      const user = userEvent.setup();
      render(<KnowledgeContextEditor {...defaultProps} />);

      const editButton = screen.getByText('Edit');
      await user.click(editButton);

      const textarea = screen.getByPlaceholderText(
        'Enter knowledge context information...'
      );
      await user.type(textarea, ' - modified');

      const saveButton = screen.getByText('Save Changes');
      expect(saveButton).not.toBeDisabled();
    });

    it('should show saving state during save', async () => {
      const user = userEvent.setup();
      let resolveSave: () => void;
      const savePromise = new Promise<void>((resolve) => {
        resolveSave = resolve;
      });
      defaultProps.onSave.mockReturnValue(savePromise);

      render(<KnowledgeContextEditor {...defaultProps} />);

      const editButton = screen.getByText('Edit');
      await user.click(editButton);

      const textarea = screen.getByPlaceholderText(
        'Enter knowledge context information...'
      );
      await user.type(textarea, ' modified');

      const saveButton = screen.getByText('Save Changes');
      await user.click(saveButton);

      expect(screen.getByText('Saving...')).toBeInTheDocument();
      expect(screen.getByRole('img', { hidden: true })).toBeInTheDocument(); // Loading spinner

      resolveSave!();
      await waitFor(() => {
        expect(screen.queryByText('Saving...')).not.toBeInTheDocument();
      });
    });

    it('should disable buttons during save', async () => {
      const user = userEvent.setup();
      let resolveSave: () => void;
      const savePromise = new Promise<void>((resolve) => {
        resolveSave = resolve;
      });
      defaultProps.onSave.mockReturnValue(savePromise);

      render(<KnowledgeContextEditor {...defaultProps} />);

      const editButton = screen.getByText('Edit');
      await user.click(editButton);

      const textarea = screen.getByPlaceholderText(
        'Enter knowledge context information...'
      );
      await user.type(textarea, ' modified');

      const saveButton = screen.getByText('Save Changes');
      await user.click(saveButton);

      expect(screen.getByText('Cancel')).toBeDisabled();
      expect(screen.getByText('Saving...')).toBeDisabled();

      resolveSave!();
    });

    it('should handle save error', async () => {
      const user = userEvent.setup();
      const consoleErrorSpy = vi
        .spyOn(console, 'error')
        .mockImplementation(() => {});
      window.alert = vi.fn();
      defaultProps.onSave.mockRejectedValue(new Error('Save failed'));

      render(<KnowledgeContextEditor {...defaultProps} />);

      const editButton = screen.getByText('Edit');
      await user.click(editButton);

      const textarea = screen.getByPlaceholderText(
        'Enter knowledge context information...'
      );
      await user.type(textarea, ' modified');

      const saveButton = screen.getByText('Save Changes');
      await user.click(saveButton);

      await waitFor(() => {
        expect(consoleErrorSpy).toHaveBeenCalledWith(
          'Failed to save knowledge context:',
          expect.any(Error)
        );
        expect(window.alert).toHaveBeenCalledWith(
          'Failed to save knowledge context. Please try again.'
        );
      });

      // Should remain in edit mode after error
      expect(
        screen.getByPlaceholderText('Enter knowledge context information...')
      ).toBeInTheDocument();

      consoleErrorSpy.mockRestore();
    });
  });

  describe('Canceling Changes', () => {
    it('should cancel changes and exit edit mode', async () => {
      const user = userEvent.setup();
      render(<KnowledgeContextEditor {...defaultProps} />);

      const editButton = screen.getByText('Edit');
      await user.click(editButton);

      const textarea = screen.getByPlaceholderText(
        'Enter knowledge context information...'
      );
      await user.clear(textarea);
      await user.type(textarea, 'Modified text');

      const cancelButton = screen.getByText('Cancel');
      await user.click(cancelButton);

      await waitFor(() => {
        expect(
          screen.queryByPlaceholderText('Enter knowledge context information...')
        ).not.toBeInTheDocument();
      });

      // Should show original context
      expect(
        screen.getByText('Initial knowledge context')
      ).toBeInTheDocument();
    });

    it('should restore initial context after cancel', async () => {
      const user = userEvent.setup();
      render(<KnowledgeContextEditor {...defaultProps} />);

      const editButton = screen.getByText('Edit');
      await user.click(editButton);

      const textarea = screen.getByPlaceholderText(
        'Enter knowledge context information...'
      );
      await user.clear(textarea);
      await user.type(textarea, 'Completely different');

      const cancelButton = screen.getByText('Cancel');
      await user.click(cancelButton);

      // Re-enter edit mode to verify context was restored
      const editButton2 = screen.getByText('Edit');
      await user.click(editButton2);

      const textarea2 = screen.getByPlaceholderText(
        'Enter knowledge context information...'
      );
      expect(textarea2).toHaveValue('Initial knowledge context');
    });

    it('should not call onSave when canceling', async () => {
      const user = userEvent.setup();
      render(<KnowledgeContextEditor {...defaultProps} />);

      const editButton = screen.getByText('Edit');
      await user.click(editButton);

      const textarea = screen.getByPlaceholderText(
        'Enter knowledge context information...'
      );
      await user.type(textarea, ' modified');

      const cancelButton = screen.getByText('Cancel');
      await user.click(cancelButton);

      expect(defaultProps.onSave).not.toHaveBeenCalled();
    });
  });

  describe('Change Detection', () => {
    it('should detect changes when text is added', async () => {
      const user = userEvent.setup();
      render(<KnowledgeContextEditor {...defaultProps} />);

      const editButton = screen.getByText('Edit');
      await user.click(editButton);

      const textarea = screen.getByPlaceholderText(
        'Enter knowledge context information...'
      );
      await user.type(textarea, ' extra');

      const saveButton = screen.getByText('Save Changes');
      expect(saveButton).not.toBeDisabled();
    });

    it('should detect changes when text is removed', async () => {
      const user = userEvent.setup();
      render(<KnowledgeContextEditor {...defaultProps} />);

      const editButton = screen.getByText('Edit');
      await user.click(editButton);

      const textarea = screen.getByPlaceholderText(
        'Enter knowledge context information...'
      );
      await user.clear(textarea);
      await user.type(textarea, 'Shorter');

      const saveButton = screen.getByText('Save Changes');
      expect(saveButton).not.toBeDisabled();
    });

    it('should not detect changes when text is unchanged', async () => {
      const user = userEvent.setup();
      render(<KnowledgeContextEditor {...defaultProps} />);

      const editButton = screen.getByText('Edit');
      await user.click(editButton);

      // Don't make any changes

      const saveButton = screen.getByText('Save Changes');
      expect(saveButton).toBeDisabled();
    });

    it('should not detect changes when text is changed back to original', async () => {
      const user = userEvent.setup();
      render(<KnowledgeContextEditor {...defaultProps} />);

      const editButton = screen.getByText('Edit');
      await user.click(editButton);

      const textarea = screen.getByPlaceholderText(
        'Enter knowledge context information...'
      );
      await user.clear(textarea);
      await user.type(textarea, 'Different text');

      // Change it back
      await user.clear(textarea);
      await user.type(textarea, 'Initial knowledge context');

      const saveButton = screen.getByText('Save Changes');
      expect(saveButton).toBeDisabled();
    });
  });

  describe('Edge Cases', () => {
    it('should handle undefined initialContext', () => {
      render(
        <KnowledgeContextEditor {...defaultProps} initialContext={undefined} />
      );

      expect(
        screen.getByText('No knowledge context provided yet.')
      ).toBeInTheDocument();
    });

    it('should allow saving empty context', async () => {
      const user = userEvent.setup();
      render(<KnowledgeContextEditor {...defaultProps} />);

      const editButton = screen.getByText('Edit');
      await user.click(editButton);

      const textarea = screen.getByPlaceholderText(
        'Enter knowledge context information...'
      );
      await user.clear(textarea);

      const saveButton = screen.getByText('Save Changes');
      await user.click(saveButton);

      await waitFor(() => {
        expect(defaultProps.onSave).toHaveBeenCalledWith('');
      });
    });

    it('should handle very long context', async () => {
      const longContext = 'A'.repeat(10000);
      render(
        <KnowledgeContextEditor {...defaultProps} initialContext={longContext} />
      );

      expect(screen.getByText(longContext)).toBeInTheDocument();
    });

    it('should handle context with special characters', () => {
      const specialContext = 'Test <script>alert("xss")</script> & "quotes"';
      render(
        <KnowledgeContextEditor
          {...defaultProps}
          initialContext={specialContext}
        />
      );

      expect(screen.getByText(specialContext)).toBeInTheDocument();
    });

    it('should handle context with line breaks', () => {
      const multilineContext = 'Line 1\nLine 2\nLine 3';
      render(
        <KnowledgeContextEditor
          {...defaultProps}
          initialContext={multilineContext}
        />
      );

      expect(screen.getByText(multilineContext)).toBeInTheDocument();
    });
  });
});
