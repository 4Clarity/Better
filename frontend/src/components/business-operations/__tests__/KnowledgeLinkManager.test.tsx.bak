import { describe, it, expect, beforeEach, afterEach, vi } from 'vitest';
import { render, screen, waitFor, within } from '@testing-library/react';
import userEvent from '@testing-library/user-event';
import KnowledgeLinkManager from '../KnowledgeLinkManager';
import * as productProgramApi from '../../../services/productProgramApi';

// Mock the product program API
vi.mock('../../../services/productProgramApi');

const mockProductProgramApi = productProgramApi as any;

describe('KnowledgeLinkManager', () => {
  const defaultProps = {
    productProgramId: 'test-product-id',
    canEdit: true,
  };

  const mockLinks = [
    {
      id: 'link-1',
      productProgramId: 'test-product-id',
      knowledgeItemId: 'km-item-123',
      linkType: 'Reference',
      linkedAt: '2024-01-15T00:00:00Z',
      linkedBy: 'user-1',
      linkedByUser: {
        id: 'user-1',
        person: {
          firstName: 'John',
          lastName: 'Doe',
        },
      },
    },
    {
      id: 'link-2',
      productProgramId: 'test-product-id',
      knowledgeItemId: 'km-item-456',
      linkType: 'Dependency',
      linkedAt: '2024-02-01T00:00:00Z',
      linkedBy: 'user-2',
      linkedByUser: {
        id: 'user-2',
        person: {
          firstName: 'Jane',
          lastName: 'Smith',
        },
      },
    },
  ];

  beforeEach(() => {
    vi.clearAllMocks();
    mockProductProgramApi.getKnowledgeLinks.mockResolvedValue(mockLinks);
    mockProductProgramApi.linkKnowledgeItem.mockResolvedValue({
      id: 'new-link-id',
      productProgramId: 'test-product-id',
      knowledgeItemId: 'km-item-789',
      linkType: 'Reference',
      linkedAt: '2024-03-01T00:00:00Z',
      linkedBy: 'current-user',
    });
    mockProductProgramApi.unlinkKnowledgeItem.mockResolvedValue(undefined);
  });

  afterEach(() => {
    vi.restoreAllMocks();
  });

  describe('Rendering', () => {
    it('should render loading state initially', () => {
      render(<KnowledgeLinkManager {...defaultProps} />);
      expect(screen.getByRole('img', { hidden: true })).toBeInTheDocument();
    });

    it('should render knowledge links after loading', async () => {
      render(<KnowledgeLinkManager {...defaultProps} />);

      await waitFor(() => {
        expect(screen.getByText('km-item-123')).toBeInTheDocument();
      });

      expect(screen.getByText('km-item-456')).toBeInTheDocument();
      expect(screen.getByText('2 knowledge items linked')).toBeInTheDocument();
    });

    it('should show empty state when no links exist', async () => {
      mockProductProgramApi.getKnowledgeLinks.mockResolvedValue([]);
      render(<KnowledgeLinkManager {...defaultProps} />);

      await waitFor(() => {
        expect(
          screen.getByText('No knowledge items linked yet.')
        ).toBeInTheDocument();
      });

      expect(
        screen.getByText(
          'Click "Link Knowledge Item" to connect relevant documentation.'
        )
      ).toBeInTheDocument();
    });

    it('should show Link Knowledge Item button when canEdit is true', async () => {
      render(<KnowledgeLinkManager {...defaultProps} />);

      await waitFor(() => {
        expect(screen.getByText('Link Knowledge Item')).toBeInTheDocument();
      });
    });

    it('should not show Link Knowledge Item button when canEdit is false', async () => {
      render(<KnowledgeLinkManager {...defaultProps} canEdit={false} />);

      await waitFor(() => {
        expect(
          screen.queryByText('Link Knowledge Item')
        ).not.toBeInTheDocument();
      });
    });

    it('should display link type badges', async () => {
      render(<KnowledgeLinkManager {...defaultProps} />);

      await waitFor(() => {
        expect(screen.getByText('Reference')).toBeInTheDocument();
      });

      expect(screen.getByText('Dependency')).toBeInTheDocument();
    });

    it('should display linked dates', async () => {
      render(<KnowledgeLinkManager {...defaultProps} />);

      await waitFor(() => {
        expect(screen.getByText(/Linked Jan 15, 2024/i)).toBeInTheDocument();
      });

      expect(screen.getByText(/Linked Feb 1, 2024/i)).toBeInTheDocument();
    });

    it('should display linked by user information', async () => {
      render(<KnowledgeLinkManager {...defaultProps} />);

      await waitFor(() => {
        expect(screen.getByText(/by John Doe/i)).toBeInTheDocument();
      });

      expect(screen.getByText(/by Jane Smith/i)).toBeInTheDocument();
    });

    it('should show correct singular/plural text for link count', async () => {
      mockProductProgramApi.getKnowledgeLinks.mockResolvedValue([
        mockLinks[0],
      ]);
      render(<KnowledgeLinkManager {...defaultProps} />);

      await waitFor(() => {
        expect(screen.getByText('1 knowledge item linked')).toBeInTheDocument();
      });
    });

    it('should not show unlink button when canEdit is false', async () => {
      render(<KnowledgeLinkManager {...defaultProps} canEdit={false} />);

      await waitFor(() => {
        expect(screen.getByText('km-item-123')).toBeInTheDocument();
      });

      // Should only show external link buttons, not unlink buttons
      const buttons = screen.getAllByRole('button');
      expect(buttons).toHaveLength(2); // Only 2 external link buttons
    });
  });

  describe('Linking Knowledge Items', () => {
    it('should open link dialog when Link Knowledge Item is clicked', async () => {
      const user = userEvent.setup();
      render(<KnowledgeLinkManager {...defaultProps} />);

      await waitFor(() => {
        expect(screen.getByText('Link Knowledge Item')).toBeInTheDocument();
      });

      const linkButton = screen.getByText('Link Knowledge Item');
      await user.click(linkButton);

      expect(screen.getAllByText('Link Knowledge Item')[0]).toBeInTheDocument();
      expect(
        screen.getByPlaceholderText('Enter knowledge item ID')
      ).toBeInTheDocument();
    });

    it('should link knowledge item successfully', async () => {
      const user = userEvent.setup();
      render(<KnowledgeLinkManager {...defaultProps} />);

      await waitFor(() => {
        expect(screen.getByText('Link Knowledge Item')).toBeInTheDocument();
      });

      const linkButton = screen.getByText('Link Knowledge Item');
      await user.click(linkButton);

      const itemIdInput = screen.getByPlaceholderText('Enter knowledge item ID');
      const submitButton = screen.getByText('Link Item');

      await user.type(itemIdInput, 'km-item-789');
      await user.click(submitButton);

      await waitFor(() => {
        expect(mockProductProgramApi.linkKnowledgeItem).toHaveBeenCalledWith(
          'test-product-id',
          {
            knowledgeItemId: 'km-item-789',
            linkType: 'Reference',
          }
        );
      });
    });

    it('should disable Link Item button when knowledge item ID is empty', async () => {
      const user = userEvent.setup();
      render(<KnowledgeLinkManager {...defaultProps} />);

      await waitFor(() => {
        expect(screen.getByText('Link Knowledge Item')).toBeInTheDocument();
      });

      const linkButton = screen.getByText('Link Knowledge Item');
      await user.click(linkButton);

      const submitButton = screen.getByText('Link Item');
      expect(submitButton).toBeDisabled();
    });

    it('should close dialog and reset form after successful link', async () => {
      const user = userEvent.setup();
      render(<KnowledgeLinkManager {...defaultProps} />);

      await waitFor(() => {
        expect(screen.getByText('Link Knowledge Item')).toBeInTheDocument();
      });

      const linkButton = screen.getByText('Link Knowledge Item');
      await user.click(linkButton);

      const itemIdInput = screen.getByPlaceholderText('Enter knowledge item ID');
      const submitButton = screen.getByText('Link Item');

      await user.type(itemIdInput, 'km-item-789');
      await user.click(submitButton);

      await waitFor(() => {
        expect(
          screen.queryByPlaceholderText('Enter knowledge item ID')
        ).not.toBeInTheDocument();
      });
    });

    it('should handle link knowledge item error', async () => {
      const user = userEvent.setup();
      const consoleErrorSpy = vi
        .spyOn(console, 'error')
        .mockImplementation(() => {});
      window.alert = vi.fn();
      mockProductProgramApi.linkKnowledgeItem.mockRejectedValue(
        new Error('Link failed')
      );

      render(<KnowledgeLinkManager {...defaultProps} />);

      await waitFor(() => {
        expect(screen.getByText('Link Knowledge Item')).toBeInTheDocument();
      });

      const linkButton = screen.getByText('Link Knowledge Item');
      await user.click(linkButton);

      const itemIdInput = screen.getByPlaceholderText('Enter knowledge item ID');
      const submitButton = screen.getByText('Link Item');

      await user.type(itemIdInput, 'km-item-789');
      await user.click(submitButton);

      await waitFor(() => {
        expect(consoleErrorSpy).toHaveBeenCalledWith(
          'Failed to link knowledge item:',
          expect.any(Error)
        );
        expect(window.alert).toHaveBeenCalledWith(
          'Failed to link knowledge item. It may already be linked.'
        );
      });

      consoleErrorSpy.mockRestore();
    });

    it('should cancel link and reset form', async () => {
      const user = userEvent.setup();
      render(<KnowledgeLinkManager {...defaultProps} />);

      await waitFor(() => {
        expect(screen.getByText('Link Knowledge Item')).toBeInTheDocument();
      });

      const linkButton = screen.getByText('Link Knowledge Item');
      await user.click(linkButton);

      const itemIdInput = screen.getByPlaceholderText('Enter knowledge item ID');
      await user.type(itemIdInput, 'km-item-789');

      const cancelButton = screen.getByText('Cancel');
      await user.click(cancelButton);

      await waitFor(() => {
        expect(
          screen.queryByPlaceholderText('Enter knowledge item ID')
        ).not.toBeInTheDocument();
      });
    });
  });

  describe('Link Type Selection', () => {
    it('should allow selecting different link types', async () => {
      const user = userEvent.setup();
      render(<KnowledgeLinkManager {...defaultProps} />);

      await waitFor(() => {
        expect(screen.getByText('Link Knowledge Item')).toBeInTheDocument();
      });

      const linkButton = screen.getByText('Link Knowledge Item');
      await user.click(linkButton);

      const linkTypeSelect = screen.getByRole('combobox');
      await user.click(linkTypeSelect);

      // Check that all link type options are available
      expect(screen.getAllByText('Reference')[0]).toBeInTheDocument();
      expect(screen.getByText('Related')).toBeInTheDocument();
      expect(screen.getAllByText('Dependency')[0]).toBeInTheDocument();
    });

    it('should create link with selected link type', async () => {
      const user = userEvent.setup();
      render(<KnowledgeLinkManager {...defaultProps} />);

      await waitFor(() => {
        expect(screen.getByText('Link Knowledge Item')).toBeInTheDocument();
      });

      const linkButton = screen.getByText('Link Knowledge Item');
      await user.click(linkButton);

      const itemIdInput = screen.getByPlaceholderText('Enter knowledge item ID');
      const linkTypeSelect = screen.getByRole('combobox');

      await user.type(itemIdInput, 'km-item-789');
      await user.click(linkTypeSelect);
      await user.click(screen.getByText('Related'));

      const submitButton = screen.getByText('Link Item');
      await user.click(submitButton);

      await waitFor(() => {
        expect(mockProductProgramApi.linkKnowledgeItem).toHaveBeenCalledWith(
          'test-product-id',
          {
            knowledgeItemId: 'km-item-789',
            linkType: 'Related',
          }
        );
      });
    });
  });

  describe('Unlinking Knowledge Items', () => {
    it('should unlink knowledge item after confirmation', async () => {
      const user = userEvent.setup();
      window.confirm = vi.fn(() => true);

      render(<KnowledgeLinkManager {...defaultProps} />);

      await waitFor(() => {
        expect(screen.getByText('km-item-123')).toBeInTheDocument();
      });

      const linkCard = screen
        .getByText('km-item-123')
        .closest('div.flex.items-center.justify-between');
      const unlinkButton = within(linkCard!).getAllByRole('button')[1]; // Second button is Unlink
      await user.click(unlinkButton);

      await waitFor(() => {
        expect(mockProductProgramApi.unlinkKnowledgeItem).toHaveBeenCalledWith(
          'link-1'
        );
      });
    });

    it('should not unlink if confirmation is cancelled', async () => {
      const user = userEvent.setup();
      window.confirm = vi.fn(() => false);

      render(<KnowledgeLinkManager {...defaultProps} />);

      await waitFor(() => {
        expect(screen.getByText('km-item-123')).toBeInTheDocument();
      });

      const linkCard = screen
        .getByText('km-item-123')
        .closest('div.flex.items-center.justify-between');
      const unlinkButton = within(linkCard!).getAllByRole('button')[1];
      await user.click(unlinkButton);

      expect(mockProductProgramApi.unlinkKnowledgeItem).not.toHaveBeenCalled();
    });

    it('should handle unlink error', async () => {
      const user = userEvent.setup();
      const consoleErrorSpy = vi
        .spyOn(console, 'error')
        .mockImplementation(() => {});
      window.confirm = vi.fn(() => true);
      mockProductProgramApi.unlinkKnowledgeItem.mockRejectedValue(
        new Error('Unlink failed')
      );

      render(<KnowledgeLinkManager {...defaultProps} />);

      await waitFor(() => {
        expect(screen.getByText('km-item-123')).toBeInTheDocument();
      });

      const linkCard = screen
        .getByText('km-item-123')
        .closest('div.flex.items-center.justify-between');
      const unlinkButton = within(linkCard!).getAllByRole('button')[1];
      await user.click(unlinkButton);

      await waitFor(() => {
        expect(consoleErrorSpy).toHaveBeenCalledWith(
          'Failed to unlink knowledge item:',
          expect.any(Error)
        );
      });

      consoleErrorSpy.mockRestore();
    });
  });

  describe('External Link Navigation', () => {
    it('should open knowledge item in new tab when external link is clicked', async () => {
      const user = userEvent.setup();
      window.open = vi.fn();

      render(<KnowledgeLinkManager {...defaultProps} />);

      await waitFor(() => {
        expect(screen.getByText('km-item-123')).toBeInTheDocument();
      });

      const linkCard = screen
        .getByText('km-item-123')
        .closest('div.flex.items-center.justify-between');
      const externalLinkButton = within(linkCard!).getAllByRole('button')[0]; // First button is External Link
      await user.click(externalLinkButton);

      expect(window.open).toHaveBeenCalledWith(
        '/knowledge/km-item-123',
        '_blank'
      );
    });
  });

  describe('Link Type Badges', () => {
    it('should display correct badge styling for Reference links', async () => {
      render(<KnowledgeLinkManager {...defaultProps} />);

      await waitFor(() => {
        const referenceBadge = screen.getByText('Reference');
        expect(referenceBadge).toHaveClass('bg-blue-100', 'text-blue-800');
      });
    });

    it('should display correct badge styling for Dependency links', async () => {
      render(<KnowledgeLinkManager {...defaultProps} />);

      await waitFor(() => {
        const dependencyBadge = screen.getByText('Dependency');
        expect(dependencyBadge).toHaveClass('bg-orange-100', 'text-orange-800');
      });
    });

    it('should handle links with no link type', async () => {
      const linkWithoutType = {
        ...mockLinks[0],
        linkType: undefined,
      };

      mockProductProgramApi.getKnowledgeLinks.mockResolvedValue([
        linkWithoutType,
      ]);

      render(<KnowledgeLinkManager {...defaultProps} />);

      await waitFor(() => {
        expect(screen.getByText('km-item-123')).toBeInTheDocument();
      });

      // Badge should not be rendered for links without a type
      expect(screen.queryByText('Reference')).not.toBeInTheDocument();
    });
  });

  describe('Loading Errors', () => {
    it('should handle load links error', async () => {
      const consoleErrorSpy = vi
        .spyOn(console, 'error')
        .mockImplementation(() => {});
      mockProductProgramApi.getKnowledgeLinks.mockRejectedValue(
        new Error('Load failed')
      );

      render(<KnowledgeLinkManager {...defaultProps} />);

      await waitFor(() => {
        expect(consoleErrorSpy).toHaveBeenCalledWith(
          'Failed to load knowledge links:',
          expect.any(Error)
        );
      });

      consoleErrorSpy.mockRestore();
    });
  });

  describe('Empty State Display', () => {
    it('should not show helper text in empty state when canEdit is false', async () => {
      mockProductProgramApi.getKnowledgeLinks.mockResolvedValue([]);
      render(<KnowledgeLinkManager {...defaultProps} canEdit={false} />);

      await waitFor(() => {
        expect(
          screen.getByText('No knowledge items linked yet.')
        ).toBeInTheDocument();
      });

      expect(
        screen.queryByText(
          'Click "Link Knowledge Item" to connect relevant documentation.'
        )
      ).not.toBeInTheDocument();
    });
  });
});
