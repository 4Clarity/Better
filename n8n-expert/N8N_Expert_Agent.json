    {
      "parameters": {
        "jsCode": "// Get all items and extract workflow IDs\nconst items = $input.all();\n\n// Get the aggregated workflow_ids array (already an array from Aggregate node)\nconst workflowIds = items[0].json.workflow_ids || [];\n\n// Convert all to numbers and collect\nconst allWorkflowIds = workflowIds.map(id => parseInt(id));\n\n// Count valid matches (not -1)\nconst validMatches = allWorkflowIds.filter(id => id !== -1);\nconst needsGapAnalysis = validMatches.length === 0;\n\n// Get original query from Edit Fields node\nconst query = $('Edit Fields').first().json.query;\n\nreturn [{\n  json: {\n    workflow_ids: workflowIds,\n    filtered_workflow_ids: allWorkflowIds,\n    valid_workflow_ids: validMatches,\n    needsGapAnalysis: needsGapAnalysis,\n    hasValidMatches: validMatches.length > 0,\n    match_count: validMatches.length,\n    original_query: query\n  }\n}];"
      },
      "id": "9806ba43-fadc-494f-973f-6490db7e35b1",
      "name": "Gap Analysis Trigger",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1920,
        640
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "81125c4a-765e-4cf3-b986-088108a3a9d6",
              "leftValue": "={{ $json.hasValidMatches }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "6e2c6af6-0b9e-406e-b494-f76365155ab2",
      "name": "Check for Matches",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        2120,
        640
      ]
    },
    {
      "parameters": {
        "model": "gpt-4o-mini",
        "options": {}
      },
      "id": "f8f1ff90-9a7b-4c87-92a7-c71671cad7db",
      "name": "Gap Analysis Chat Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1,
      "position": [
        2500,
        840
      ],
      "credentials": {
        "openAiApi": {
          "id": "05Q6PbnSdyEcu9Ze",
          "name": "OpenAi account"
        }
