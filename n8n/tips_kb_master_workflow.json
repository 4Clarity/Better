      "typeVersion": 1,
      "position": [250, 300]
    },
    {
      "parameters": {
        "path": "file-upload",
        "method": "POST",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "webhook-file-upload",
      "name": "Webhook - File Upload",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [450, 200],
      "webhookId": "file-upload-trigger"
    },
    {
      "parameters": {
        "path": "message-received",
        "method": "POST",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "webhook-message",
      "name": "Webhook - Message Received",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [450, 400],
      "webhookId": "message-trigger"
    },
    {
      "parameters": {
        "path": "user-event",
        "method": "POST",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "webhook-user-event",
      "name": "Webhook - User Event",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [450, 600],
      "webhookId": "user-event-trigger"
    },
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "hoursInterval": 6
            }
          ]
        }
      },
      "id": "schedule-batch",
      "name": "Schedule - Batch Processing",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1,
      "position": [450, 800]
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $json.event_type }}",
              "operation": "equals",
              "value2": "file_upload"
            }
          ]
        }
      },
      "id": "route-event-type",
      "name": "Route - Event Type",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [650, 400]
    },
    {
      "parameters": {
        "jsCode": "// Master Event Classifier\nconst eventType = $input.first().json.event_type || 'unknown';\nconst eventData = $input.first().json;\n\n// Determine routing\nlet route = 'unknown';\nlet priority = 'normal';\nlet context = {};\n\nif (eventType === 'file_upload') {\n  route = 'document_ingestion';\n  \n  // Check for transition context\n  if (eventData.transition_id) {\n    priority = eventData.transition_type === 'major' ? 'critical' : 'high';\n    context.transition = true;\n  }\n  \n  // Check for offboarding source\n  if (eventData.source === 'offboarding') {\n    priority = 'high';\n    context.offboarding_sourced = true;\n  }\n  \n} else if (eventType === 'message' || eventType === 'communication') {\n  route = 'message_processing';\n  priority = 'normal';\n  \n  // Check user context\n  if (eventData.user_status === 'onboarding') {\n    context.onboarding_user = true;\n  } else if (eventData.user_status === 'offboarding') {\n    context.offboarding_user = true;\n  }\n  \n} else if (eventType === 'user_created') {\n  route = 'user_onboarding';\n  priority = 'high';\n  \n} else if (eventType === 'user_offboarding') {\n  route = 'user_offboarding';\n  priority = 'high';\n  \n} else if (eventType === 'role_change') {\n  route = 'personnel_transition';\n  priority = 'high';\n  \n} else if (eventType === 'transition_initiated') {\n  route = 'transition_management';\n  priority = eventData.transition_type === 'major' ? 'critical' : 'high';\n  \n} else if (eventType === 'learning_request') {\n  route = 'user_requested_learning';\n  priority = 'normal';\n  \n} else if (eventType === 'search_query') {\n  route = 'search_retrieval';\n  priority = 'normal';\n  \n} else if (eventType === 'batch_processing') {\n  route = 'batch_ingestion';\n  priority = 'low';\n}\n\nreturn [{\n  json: {\n    ...eventData,\n    routing: {\n      route: route,\n      priority: priority,\n      context: context,\n      timestamp: new Date().toISOString()\n    }\n  }\n}];"
      },
      "id": "classify-event",
      "name": "Classify Event & Route",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [850, 400]
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $json.routing.route }}",
              "operation": "equals",
              "value2": "document_ingestion"
            }
          ]
        }
      },
      "id": "switch-route",
      "name": "Switch - Route to Workflow",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 1,
      "position": [1050, 400],
      "parameters": {
        "mode": "rules",
        "rules": {
          "rules": [
            {
              "conditions": {
                "string": [
                  {
                    "value1": "={{ $json.routing.route }}",
                    "value2": "document_ingestion"
                  }
                ]
              },
              "renameOutput": true,
              "outputKey": "document_ingestion"
            },
            {
              "conditions": {
                "string": [
                  {
                    "value1": "={{ $json.routing.route }}",
                    "value2": "message_processing"
                  }
                ]
              },
              "renameOutput": true,
              "outputKey": "message_processing"
            },
            {
              "conditions": {
                "string": [
                  {
                    "value1": "={{ $json.routing.route }}",
                    "value2": "user_onboarding"
                  }
                ]
              },
              "renameOutput": true,
              "outputKey": "user_onboarding"
            },
            {
              "conditions": {
                "string": [
                  {
                    "value1": "={{ $json.routing.route }}",
                    "value2": "user_offboarding"
                  }
                ]
              },
              "renameOutput": true,
              "outputKey": "user_offboarding"
            },
            {
              "conditions": {
                "string": [
                  {
                    "value1": "={{ $json.routing.route }}",
                    "value2": "transition_management"
                  }
                ]
              },
              "renameOutput": true,
              "outputKey": "transition_management"
            }
          ]
        }
      }
    },
    {
      "parameters": {
        "workflowId": "={{ $json.workflow_ids.document_ingestion }}"
      },
      "id": "execute-doc-ingestion",
      "name": "Execute - Document Ingestion",
