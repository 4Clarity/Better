      "main": [
        [{"node": "Apply Override to Documents", "type": "main", "index": 0}],
        [{"node": "Log Rejection", "type": "main", "index": 0}]
      ]
    },
    "Apply Override to Documents": {
      "main": [[{"node": "Update Chunk Override Status", "type": "main", "index": 0}]]
    },
