    },
    "Notify Override Applied": {
      "main": [[{"node": "Generate Response", "type": "main", "index": 0}]]
    },
    "Log Rejection": {
      "main": [[{"node": "Generate Response", "type": "main", "index": 0}]]
    },
    "Process Update Message": {
      "main": [[{"node": "Store Temporal Update", "type": "main", "index": 0}]]
    },
    "Store Temporal Update": {
      "main": [[{"node": "Trigger Baseline Update", "type": "main", "index": 0}]]
    },
    "Trigger Baseline Update": {
      "main": [[{"node": "Generate Response", "type": "main", "index": 0}]]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}