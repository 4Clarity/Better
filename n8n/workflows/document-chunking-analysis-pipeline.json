    {
      "parameters": {
        "url": "http://backend-python:8000/api/n8n/check-duplicate",
        "method": "POST",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "httpHeaderAuth",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "document_id",
              "value": "={{ $json.document_id }}"
            },
            {
              "name": "filename",
              "value": "={{ $json.filename }}"
            },
            {
              "name": "mime_type",
              "value": "={{ $json.mime_type }}"
            },
            {
              "name": "storage_path",
              "value": "={{ $json.storage_path }}"
            }
          ]
        },
        "options": {
          "timeout": 60000,
          "retry": {
            "enabled": true,
            "maxRetries": 3,
            "waitBetweenRetries": 5000,
            "retryOnHttpStatusCodes": [
              {
                "values": "500..599"
              }
            ]
          }
        }
      },
      "id": "check-duplicate-002",
      "name": "Check for Duplicates",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        460,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{ $json.is_duplicate }}",
              "value2": true
            },
            {
              "value1": "={{ $json.strategy }}",
              "value2": "SKIP"
            }
          ]
        },
        "combineOperation": "all"
      },
      "id": "if-duplicate-skip-003",
      "name": "IF Duplicate SKIP",
